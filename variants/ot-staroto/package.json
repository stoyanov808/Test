{
  "name": "ot-staroto",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --open",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/standalone.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-test.ts",
    "simulate": "tsx scripts/simulate.ts",
    "math:build": "tsx scripts/build-math-model.ts",
    "math:check": "tsx scripts/verify-math-model.ts",
    "math:check:full": "tsx scripts/verify-math-outcomes.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "1.56.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  }
}
